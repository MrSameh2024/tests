function buildPathways() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var src = findUsageSheet_(ss);
  if (!src) throw new Error('No tab with "page" and "ref" columns was found.');
  var v = src.getDataRange().getValues();
  var head = v[0].map(function (h) { return String(h).toLowerCase().trim(); });
  var col = function (names) { for (var i = 0; i < names.length; i++) { var j = head.indexOf(names[i]); if (j >= 0) return j; } return -1; };
  var cT = col(['time', 'timestamp', 'date', 'received']), cN = col(['name', 'student']), cE = col(['email']), cP = col(['phone', 'mobile']),
      cPage = col(['page']), cRef = col(['ref', 'reference', 'file', 'resource']);
  var att = [], opens = [];
  for (var r = 1; r < v.length; r++) {
    var page = String(v[r][cPage] || ''), ref = String(v[r][cRef] || '');
    if (page !== 'pathway' && page !== 'pathway-open') continue;
    if (/boy@school\.qa/i.test(String(v[r][cE] || ''))) continue; // test account
    var who = String(v[r][cE] || v[r][cP] || v[r][cN] || 'unknown').trim().toLowerCase();
    var name = String(v[r][cN] || '');
    var t = cT >= 0 ? v[r][cT] : r;
    if (page === 'pathway') {
      var parts = ref.split(' | ');
      var skills = {};
      ['weak: ', 'ok: '].forEach(function (pre) {
        parts.filter(function (p) { return p.indexOf(pre) === 0; }).forEach(function (p) {
          p.slice(pre.length).split(', ').forEach(function (x) {
            var m = x.match(/^([A-Z_]+)\s+(\d+)\/(\d+)$/); if (m) skills[m[1]] = [+m[2], +m[3]];
            else if (/^[A-Z_]+$/.test(x)) skills[x] = [1, 1];
          });
        });
      });
      att.push({ who: who, name: name, t: t, test: parts[0], grade: (parts[1] || '').replace('G', ''), pct: parseInt(parts[2], 10) || 0, lv: parts[3] || '', sk: skills });
    } else {
      var q = ref.split(' | ');
      opens.push({ who: who, t: t, res: q[0], sk: (q[1] || '').replace('for ', '') });
    }
  }
  att.sort(function (a, b) { return a.t < b.t ? -1 : 1; });
  // per student × skill
  var per = {}, bySkill = {};
  att.forEach(function (a) {
    Object.keys(a.sk).forEach(function (k) {
      var key = a.who + '¦' + k, g = a.sk[k];
      per[key] = per[key] || { who: a.who, name: a.name, grade: a.grade, sk: k, hist: [] };
      per[key].hist.push({ t: a.t, pct: Math.round(100 * g[0] / g[1]), test: a.test });
      if (g[0] < g[1]) { bySkill[k] = bySkill[k] || { students: {}, times: 0, got: 0, tot: 0 }; bySkill[k].students[a.who] = 1; bySkill[k].times++; }
      if (bySkill[k]) { bySkill[k].got += g[0]; bySkill[k].tot += g[1]; }
    });
  });
  var opened = {};
  opens.forEach(function (o) { var k = o.who + '¦' + o.sk; opened[k] = (opened[k] || 0) + 1; });

  var out = ss.getSheetByName('Learning Pathways') || ss.insertSheet('Learning Pathways');
  out.clear();
  var rows = [];
  rows.push(['Learning Pathways · المسارات التعليمية', '', '', '', '', '', '', '']);
  rows.push(['Rebuilt ' + Utilities.formatDate(new Date(), Session.getScriptTimeZone(), 'd MMM yyyy HH:mm'), 'Checked tests: ' + att.length, 'Students: ' + Object.keys(att.reduce(function (o, a) { o[a.who] = 1; return o; }, {})).length, 'Resources opened: ' + opens.length, '', '', '', '']);
  rows.push(['', '', '', '', '', '', '', '']);
  rows.push(['RECURRING WEAKNESSES', 'Area', 'Students flagged', 'Times flagged', 'Success rate', 'Recommended intervention', '', '']);
  Object.keys(bySkill).sort(function (a, b) { return Object.keys(bySkill[b].students).length - Object.keys(bySkill[a].students).length || bySkill[b].times - bySkill[a].times; })
    .forEach(function (k) {
      var s = SSH_SKILLS[k] || [k, '', ''], b = bySkill[k];
      rows.push([s[0], s[1], Object.keys(b.students).length, b.times, b.tot ? Math.round(100 * b.got / b.tot) + '%' : '', s[2], '', '']);
    });
  rows.push(['', '', '', '', '', '', '', '']);
  rows.push(['STUDENT PROGRESS', 'Grade', 'Skill', 'First result', 'Latest result', 'Change', 'Follow-up done?', 'Resources opened']);
  Object.keys(per).sort().forEach(function (key) {
    var p = per[key], f = p.hist[0], l = p.hist[p.hist.length - 1];
    var flagged = p.hist.findIndex(function (h) { return h.pct < 100; });
    if (flagged < 0) return; // never a gap
    var follow = p.hist.length > flagged + 1 ? 'Yes (' + (p.hist.length - flagged - 1) + ')' : 'Not yet';
    rows.push([p.name ? p.name + ' · ' + p.who : p.who, p.grade, (SSH_SKILLS[p.sk] || [p.sk])[0], f.pct + '%', l.pct + '%', (l.pct - f.pct > 0 ? '+' : '') + (l.pct - f.pct), follow, opened[key] || 0]);
  });
  out.getRange(1, 1, rows.length, 8).setValues(rows);
  out.getRange(1, 1).setFontSize(14).setFontWeight('bold');
  [4].concat(rows.map(function (r, i) { return r[0] === 'STUDENT PROGRESS' ? i + 1 : 0; }).filter(Boolean)).forEach(function (n) {
    out.getRange(n, 1, 1, 8).setFontWeight('bold').setBackground('#14244a').setFontColor('#ffffff');
  });
  out.setFrozenRows(2); out.autoResizeColumns(1, 5); out.setColumnWidth(6, 420); out.getRange(1, 6, rows.length, 1).setWrap(true);
  return rows.length;
}

function findUsageSheet_(ss) {
  var named = ss.getSheetByName('Usage'); if (named) return named;
  var all = ss.getSheets();
  for (var i = 0; i < all.length; i++) {
    var h = all[i].getRange(1, 1, 1, Math.max(1, all[i].getLastColumn())).getValues()[0].map(function (x) { return String(x).toLowerCase(); });
    if (h.indexOf('page') >= 0 && (h.indexOf('ref') >= 0 || h.indexOf('file') >= 0)) return all[i];
  }
  return null;
}
